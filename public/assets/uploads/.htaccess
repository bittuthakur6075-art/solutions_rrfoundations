# RR FOUNDATIONS — UPLOAD DIRECTORY SECURITY POLICY
# Completely prevent script execution in the uploaded assets directory

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(php|phtml|phar|pl|py|jsp|asp|sh|cgi|exe)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Enforce proper MIME headers on delivered assets
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

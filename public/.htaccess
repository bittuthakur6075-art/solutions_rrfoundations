# ==============================================================================
# RR FOUNDATIONS — HOSTINGER APACHE CONFIGURATION (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS without redirect loops (Hostinger / Cloudflare compatible)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Block direct web access to internal development directories
  RewriteRule ^(scripts|src|docs|node_modules)(\/.*)?$ - [F,L]

  # 3. Route API endpoints to native PHP handlers
  RewriteRule ^api/enquiry/?$ /api/enquiry.php [L,QSA]
  RewriteRule ^api/admin/([a-zA-Z0-9_-]+)/?$ /api/admin/$1.php [L,QSA]

  # 4. Serve existing static files & prerendered directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. React SPA Fallback for client-side routing (including /admin/*)
  RewriteRule ^ index.html [L]
</IfModule>

# Security: Deny access to sensitive server files, logs, backups, and configs
<FilesMatch "(?i)\.(env|git|lock|config|bak|sql|log|md|sh|ps1|yml|yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Explicitly block sensitive build configs but allow public data json files
<FilesMatch "(?i)^(package|package-lock|composer|tsconfig|vite\.config)\.(json|ts|js|mjs)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security Response Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript font/woff2 image/svg+xml application/json
</IfModule>

# RR Foundations — Production Environment Variables Reference

# Canonical Base URL
NEXT_PUBLIC_SITE_URL=https://solutions.rrfoundations.org

# Google Analytics 4 (GA4) Integration (leave empty if not yet provisioned)
NEXT_PUBLIC_GA_ID=

# Google Search Console Verification Token (leave empty if DNS verified)
NEXT_PUBLIC_GSC_VERIFICATION=

# Transactional Email Notification Relay (Optional external dispatch)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# NOTIFICATION_RECEIVER=help@rrfoundation.org
